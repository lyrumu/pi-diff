{
  "name": "@lyrumu/pi-diff",
  "version": "0.1.0",
  "description": "pi extension: /diff — view per-turn, per-session and git changes in a fullscreen TUI",
  "type": "module",
  "main": "index.ts",
  "author": "lyrumu",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lyrumu/pi-diff.git"
  },
  "homepage": "https://github.com/lyrumu/pi-diff#readme",
  "bugs": {
    "url": "https://github.com/lyrumu/pi-diff/issues"
  },
  "keywords": ["pi-package", "pi-extension", "diff"],
  "engines": {
    "node": ">=22.19.0"
  },
  "files": ["index.ts", "src/", "README.zh-CN.md", "LICENSE", "NOTICE.md", "THIRD_PARTY_LICENSES.md"],
  "publishConfig": {
    "access": "public"
  },
  "pi": {
    "extensions": ["./index.ts"]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node tests/selftest.ts && node tests/git-selftest.ts && node tests/tui-selftest.ts && node tests/extension-selftest.ts && node tests/reliability-selftest.ts",
    "sync:opencode": "bash scripts/sync-opencode.sh"
  },
  "dependencies": {
    "diff": "^8.0.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.2.0",
    "@earendil-works/pi-tui": "1.2.0",
    "@types/diff": "^8.0.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  }
}
